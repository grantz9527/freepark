# IDE / editor config
.cursor/

# IDE files (per repository convention)
.classpath
.project
.settings/
.idea/
*.iml

# Local scratch / temp files
_tmp_*.js
_tmp_*.json

# Frigate runtime state (tracked: docker/frigate/config/config.yml, backup_config.yaml)
docker/frigate/config/.exports
docker/frigate/config/.jwt_secret
docker/frigate/config/.search_stats.json
docker/frigate/config/.timeline
docker/frigate/config/.vacuum
docker/frigate/config/*.db
docker/frigate/config/*.db-shm
docker/frigate/config/*.db-wal
docker/frigate/config/go2rtc_homekit.yml
docker/frigate/config/model_cache/

# Mosquitto runtime (tracked: docker/mosquitto/docker-compose.yml, config/mosquitto.conf)
docker/mosquitto/config/pwfile
docker/mosquitto/data/
docker/mosquitto/log/

# Server local runtime data
local_server/data/

# Frontend generated declaration files
local_frontend/src/auto-imports.d.ts
local_frontend/src/components.d.ts
