<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.freepark</groupId>
	<artifactId>zhensi-driver</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>zhensi-driver</name>
	<description>
		FreePark 臻识（Zhenshi DEMO）识别一体机驱动（示范工程）。
		厂商驱动独立工程模板：只依赖 freepark-driver-api 实现统一规范，
		不访问数据库、不依赖平台框架，可独立编译/测试/发布，
		由平台按依赖引入后经 AioDriverRegistry 装配。
	</description>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<properties>
		<java.version>21</java.version>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<freepark.driver.api.version>0.1.0-SNAPSHOT</freepark.driver.api.version>
		<jackson.version>2.18.2</jackson.version>
		<junit.version>5.10.2</junit.version>
	</properties>

	<dependencies>
		<!-- 平台驱动契约：一切能力接口/DTO 都来自这里 -->
		<dependency>
			<groupId>com.freepark</groupId>
			<artifactId>freepark-driver-api</artifactId>
			<version>${freepark.driver.api.version}</version>
		</dependency>

		<!-- 驱动自带的 HTTP 命令通道可引入自己的 JSON 客户端，不影响平台 -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>${jackson.version}</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
